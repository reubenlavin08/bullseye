# Postgres connection — install Postgres locally first (EDB installer on Windows).
# Create:
#   psql -U postgres -c "CREATE USER dealfinder WITH PASSWORD 'dealfinder';"
#   psql -U postgres -c "CREATE DATABASE dealfinder_dev OWNER dealfinder;"
DB_URL=postgresql://postgres:1@localhost:5432/dealfinder_dev

# eBay Finding API — register at developer.ebay.com (free).
EBAY_APP_ID=

# Ollama — local LLM runtime. Install from ollama.com, then:
#   ollama pull llama3.2:3b-instruct-q4_K_M
#   ollama pull nomic-embed-text
# (qwen2.5:7B is no longer required — single 3B handles all three LLM
# jobs now: title normalization, price extraction, sparse-comp fair_value
# estimation. nomic-embed-text powers semantic comp filtering.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_APPRAISAL_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_NORMALIZER_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Email alerts ---
# Pick a backend: console | smtp | resend
#   console = print emails to stdout (great for testing, no creds needed)
#   smtp    = send via any SMTP server (Gmail with app password, Fastmail, etc)
#   resend  = send via Resend's HTTP API (free tier 100/day)
#
# RECOMMENDED for personal use: Gmail SMTP. Setup steps:
#   1. Enable 2-Step Verification on your Google account (required for app passwords).
#        https://myaccount.google.com/security
#   2. Generate an App Password (16 chars, no spaces):
#        https://myaccount.google.com/apppasswords
#        - Select app: "Mail", Device: "Other" -> name it "bullseye"
#        - Copy the 16-character password (it won't be shown again).
#   3. Set the values below:
#        ALERT_BACKEND=smtp
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=youraccount@gmail.com
#        SMTP_PASSWORD=<the 16-char app password, no spaces>
#        ALERT_FROM_EMAIL=youraccount@gmail.com
#   4. Save this file as `.env` (not `.env.example`) at the repo root.
#   5. Restart the scheduler / webapp.
ALERT_BACKEND=console
ALERT_FROM_EMAIL=

# SMTP backend (used only when ALERT_BACKEND=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Resend backend (used only when ALERT_BACKEND=resend)
# Resend requires a verified domain, so it's overkill for one-user setups.
# Stick with Gmail SMTP unless you already have a domain set up there.
RESEND_API_KEY=

# Default deal-score threshold for alerts.
ALERT_SCORE_THRESHOLD=70
