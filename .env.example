# Postgres connection — install Postgres locally first (EDB installer on Windows).
# Create:
#   psql -U postgres -c "CREATE USER dealfinder WITH PASSWORD 'dealfinder';"
#   psql -U postgres -c "CREATE DATABASE dealfinder_dev OWNER dealfinder;"
DB_URL=postgresql://postgres:1@localhost:5432/dealfinder_dev

# eBay Finding API — register at developer.ebay.com (free).
EBAY_APP_ID=

# Ollama — local LLM runtime. Install from ollama.com, then:
#   ollama pull llama3.2:3b-instruct-q4_K_M
#   ollama pull nomic-embed-text
# (qwen2.5:7B is no longer required — single 3B handles all three LLM
# jobs now: title normalization, price extraction, sparse-comp fair_value
# estimation. nomic-embed-text powers semantic comp filtering.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_APPRAISAL_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_NORMALIZER_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Email alerts ---
# Pick a backend: console | smtp | resend
#   console = print emails to stdout (great for testing, no creds needed)
#   smtp    = send via any SMTP server (Gmail with app password, Fastmail, etc)
#   resend  = send via Resend's HTTP API (free tier 100/day)
#
# RECOMMENDED for personal use: Gmail SMTP. Setup steps:
#   1. Enable 2-Step Verification on your Google account (required for app passwords).
#        https://myaccount.google.com/security
#   2. Generate an App Password (16 chars, no spaces):
#        https://myaccount.google.com/apppasswords
#        - Select app: "Mail", Device: "Other" -> name it "bullseye"
#        - Copy the 16-character password (it won't be shown again).
#   3. Set the values below:
#        ALERT_BACKEND=smtp
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=youraccount@gmail.com
#        SMTP_PASSWORD=<the 16-char app password, no spaces>
#        ALERT_FROM_EMAIL=youraccount@gmail.com
#   4. Save this file as `.env` (not `.env.example`) at the repo root.
#   5. Restart the scheduler / webapp.
ALERT_BACKEND=console
ALERT_FROM_EMAIL=

# SMTP backend (used only when ALERT_BACKEND=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Resend backend (used only when ALERT_BACKEND=resend) ---
# Setup steps for personal use (sending to YOUR email only — no domain needed):
#
#   1. Create a free account at https://resend.com (no credit card required;
#      free tier = 100 emails/day, 3,000/month).
#   2. After signup you'll be on the Onboarding page. Click "API Keys" in
#      the left sidebar -> "Create API Key" -> name it "bullseye" ->
#      Permission: "Sending access" -> Domain: "All domains" -> Add.
#   3. Copy the key (starts with "re_") — you only see it once.
#   4. Set the values below:
#        ALERT_BACKEND=resend
#        RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#        ALERT_FROM_EMAIL=onboarding@resend.dev
#      (onboarding@resend.dev is Resend's free shared sender — works
#      out of the box but can ONLY send to the email you signed up with.
#      If you want to send to other addresses, you have to verify a
#      domain at resend.com/domains. For one-user personal use, the
#      shared sender is enough.)
#   5. Save this file as `.env` (not `.env.example`) at the repo root.
#   6. Restart the scheduler / webapp.
RESEND_API_KEY=

# Default deal-score threshold for alerts.
ALERT_SCORE_THRESHOLD=70

# Email batching hold-off. Wait this many seconds after the OLDEST
# pending match before sending, so multiple above-threshold listings
# arriving close together collapse into one email. Set to 0 to disable
# (immediate-send legacy behavior). Default 60s = a single match gets
# emailed up to 60s after it scores; a burst within 60s sends as one.
DIGEST_BATCH_HOLD_S=60

# --- LLM secondary-check ---
# When a listing scores anomalously high, run a local LLM second pass
# to catch obfuscated rentals ('$40 car r3ntal'), financing schemes,
# parts-only listings, replicas/toys priced against the real thing,
# scams, etc. Triggers on score >= LLM_VERIFY_HIGH_SCORE OR
# (score >= LOW_CONF_THRESHOLD AND confidence == 'low'). Suspect
# listings are auto-rejected so they never email. Default model is
# the same llama3.2:3b we use for appraisal.
LLM_SECONDARY_CHECK=1
# LLM_VERIFY_HIGH_SCORE=85
# LLM_VERIFY_LOW_CONF_THRESHOLD=70
# OLLAMA_SECONDARY_MODEL=llama3.2:3b-instruct-q4_K_M

# --- Scheduler tuning ---
# Slow-start ramp: start cautious (1 poll/min) and ramp toward floor
# while FB stays clean. Set SLOW_START_MODE=1 to enable. Reset to
# initial on any rate-limit. Recommended for first-time setup or after
# a long pause when you don't know FB's current limit on your IP.
SLOW_START_MODE=0
# SLOW_START_INITIAL_S=60         # starting effective interval
# SLOW_START_FLOOR_S=20           # fastest we'll go
# SLOW_START_HEALTHY_PERIOD_S=300 # clean window before ramping
# SLOW_START_STEP_S=5             # interval reduction per ramp step
#
# Rate-limit cooldown (always on; tunable):
# RATE_LIMIT_BASE_COOLDOWN_S=60    # 1st rate-limit cooldown
# RATE_LIMIT_MAX_COOLDOWN_S=600    # cap (10 min)
# RATE_LIMIT_WINDOW_S=1800         # 30 min rolling count window
